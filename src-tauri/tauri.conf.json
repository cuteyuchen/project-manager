{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Manager",
  "version": "1.7.0",
  "identifier": "com.cuteyuchen.project-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Manager",
        "width": 1120,
        "height": 730,
        "minWidth": 1120,
        "minHeight": 680,
        "decorations": false
      },
      {
        "label": "quick-search",
        "title": "Project Search",
        "url": "index.html?window=quick-search",
        "width": 680,
        "height": 460,
        "center": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "cuteyuchen",
    "homepage": "https://github.com/cuteyuchen/project-manager",
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Cross-platform project management desktop app",
    "longDescription": "Project Manager helps developers manage projects, Git repositories, Node.js versions, and desktop integrations.",
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "desktopTemplate": "deb/project-manager.desktop.hbs",
        "files": {
          "usr/share/metainfo/com.cuteyuchen.project-manager.metainfo.xml": "deb/com.cuteyuchen.project-manager.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNDQ2MkIzOUJEOUE1ODYKUldTR3BkbWJzMkpFVHl3OElnczlGRFJVemFITVBNb2JaRUJ5NnJJVXhST1JHNTZIZVFWTzh6TkMK",
      "endpoints": [
        "https://github.com/cuteyuchen/project-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
